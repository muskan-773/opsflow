# ---------------------------------------------------------------------------
# OpsFlow environment variables (example). Copy to .env and fill in real
# values. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Used by the backend and by the tests.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://opsflow:opsflowdev@localhost:5432/opsflow

# Test database (created by setup; used by pytest). Kept separate so tests
# never touch development data.
TEST_DATABASE_URL=postgresql+psycopg://opsflow:opsflowdev@localhost:5432/opsflow_test

# JWT signing secret. Generate a strong random value for real deployments,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS origin for the frontend dev server.
FRONTEND_ORIGIN=http://localhost:5173
